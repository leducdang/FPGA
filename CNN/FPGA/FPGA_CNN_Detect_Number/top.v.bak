module top (
    input  wire        CLOCK_50,
    input  wire [3:0]  KEY,
    output wire [6:0]  HEX0,
    output wire [9:0]  LEDR
);

    wire clk;
    wire reset_n;
    wire start_key;

    assign clk       = CLOCK_50;
    assign reset_n   = KEY[0];
    assign start_key = ~KEY[1];

    // ROM chứa ảnh test 28x28 = 784 pixel, mỗi dòng 1 byte HEX
    reg [7:0] image_rom [0:783];

    initial begin
        $readmemh("image_28x28.hex", image_rom);
    end

    reg        core_start;
    reg        feeding;
    reg [9:0]  feed_cnt;
    reg        pixel_valid;
    reg [7:0]  pixel_in;

    wire       pixel_ready;
    wire       done;
    wire [3:0] digit;
    wire       busy;
    wire [3:0] debug_state;

    reg start_key_d;

    always @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            core_start  <= 1'b0;
            feeding     <= 1'b0;
            feed_cnt    <= 10'd0;
            pixel_valid <= 1'b0;
            pixel_in    <= 8'd0;
            start_key_d <= 1'b0;
        end else begin
            start_key_d <= start_key;
            core_start  <= 1'b0;
            pixel_valid <= 1'b0;

            // Nhấn KEY1 để bắt đầu nhận dạng ảnh trong image_28x28.hex
            if (start_key && !start_key_d && !busy) begin
                core_start <= 1'b1;
                feeding    <= 1'b1;
                feed_cnt   <= 10'd0;
            end

            // Gửi lần lượt 784 pixel vào core
            if (feeding && pixel_ready) begin
                pixel_in    <= image_rom[feed_cnt];
                pixel_valid <= 1'b1;

                if (feed_cnt == 10'd783) begin
                    feeding <= 1'b0;
                end else begin
                    feed_cnt <= feed_cnt + 10'd1;
                end
            end
        end
    end

    mnist_cnn_core u_cnn (
        .clk         (clk),
        .reset_n     (reset_n),
        .start       (core_start),
        .pixel_valid (pixel_valid),
        .pixel_in    (pixel_in),
        .pixel_ready (pixel_ready),
        .busy        (busy),
        .done        (done),
        .digit       (digit),
        .debug_state (debug_state)
    );

    seven_seg u_hex0 (
        .num (digit),
        .seg (HEX0)
    );

    assign LEDR[0]   = busy;
    assign LEDR[1]   = done;
    assign LEDR[5:2] = debug_state;
    assign LEDR[9:6] = digit;

endmodule

